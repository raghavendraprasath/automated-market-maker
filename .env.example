# Copy to .env and fill in before running: npx hardhat run scripts/deploy.js --network sepolia

# Sepolia JSON-RPC endpoint (Alchemy / Infura / any provider).
# Defaults to a public node if omitted, which is fine for deploys but rate-limited.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of a Sepolia account funded from a faucet. NEVER use a mainnet key.
DEPLOYER_PRIVATE_KEY=0xyour_test_private_key

# Optional: only needed for `npx hardhat verify`.
ETHERSCAN_API_KEY=
