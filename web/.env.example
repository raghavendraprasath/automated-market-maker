# Copy to .env.local for local development, or set these in the Vercel project settings.

# Chain the UI reads from: 11155111 = Sepolia, 31337 = local Hardhat node.
NEXT_PUBLIC_CHAIN_ID=11155111

# SimpleAMMFactory address printed by `npm run deploy:sepolia`.
# Optional: falls back to web/lib/deployments.json, which the deploy script writes.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Block the factory was deployed in; used as `fromBlock` for eth_getLogs.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional. Without it the app uses viem's default public Sepolia endpoint, which needs no API key
# and works: it caps eth_getLogs at 1,000 blocks, and the history fetcher narrows its window to match.
# A keyed endpoint (Alchemy/Infura free tier) just returns the same history in one request instead of ~10.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
